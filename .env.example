# Hospedagem Square Cloud
# Em producao, o padrao e https://bot-demo.example.com.
# Preencha apenas se quiser substituir por outro dominio HTTPS (sem caminho ou /api).
PUBLIC_ORIGIN=""
# O comando start:squarecloud usa HOST=0.0.0.0 e PORT=80 por padrao.
# HOST=0.0.0.0
# PORT=80

# Digisac - ambiente de testes (legado; o login da interface nao usa estas variaveis)
# Copie para .env e preencha os valores apenas no arquivo local.

# URL base da instancia de testes, sem /api ou /api/v1.
DIGISAC_BASE_URL=""

# Token de acesso da API da conta de testes.
DIGISAC_API_TOKEN=""

# URL completa do endpoint POST de envio do robo, a confirmar com a Digisac.
DIGISAC_AUTOMATION_POST_URL=""
