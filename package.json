{
  "name": "bot-analyser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test",
    "format:check": "prettier --check src web/src tests web/index.html web/vite.config.ts playwright.config.ts",
    "format": "prettier --write src web/src tests web/index.html web/vite.config.ts playwright.config.ts",
    "demo": "node src/cli.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "start:squarecloud": "node --env-file-if-exists=.env src/squarecloud.ts",
    "dev:api": "node --watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.6"
  }
}
